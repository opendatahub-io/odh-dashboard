{
  "name": "autorag-ui",
  "version": "1.0.0",
  "description": "A user interface for AutoRAG",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.8.0",
  "overrides": {
    "js-yaml": "^4.1.1",
    "csstype": "3.2.3",
    "axios": "^1.15.0",
    "shell-quote": ">=1.8.4",
    "@types/react": "18.3.31"
  },
  "scripts": {
    "build": "run-s build:prod",
    "build:analyze": "cross-env RSDOCTOR=true npm run build:prod",
    "build:prod": "rspack --config ./config/rspack.prod.js",
    "build:clean": "rm -rf ./dist",
    "start:dev": "rspack dev --hot --config ./config/rspack.dev.js",
    "test": "run-s test:lint test:type-check test:unit test:cypress-ci",
    "test:cypress-ci": "concurrently -P -k -s first \"npm run cypress:server:bff-mock\" \"cross-env PROXY_HOST=localhost PROXY_PORT=4000 npm run cypress:server:dev\" \"wait-on -t 180000 http://localhost:9107 http-get://localhost:4000/healthcheck && npm run cypress:run:mock\" -- ",
    "test:jest": "jest",
    "test:unit": "npm run test:jest -- --silent",
    "test:fix": "eslint --ext .js,.ts,.jsx,.tsx ./src ./*.js --fix && prettier --write ./*.js ./*.cjs ./*.md ../*.md",
    "lint": "eslint --max-warnings 0 --ext .js,.ts,.jsx,.tsx ./src ./*.js",
    "lint:fix": "eslint --ext .js,.ts,.jsx,.tsx ./src ./*.js --fix",
    "test:lint": "eslint --max-warnings 0 --ext .js,.ts,.jsx,.tsx ./src ./*.js && prettier --check ./*.js ./*.cjs ./*.md ../*.md",
    "test:type-check": "tsc --noEmit",
    "cypress:open": "cypress open --project src/__tests__/cypress",
    "cypress:open:mock": "cross-env CY_MOCK=1 BASE_URL=http://localhost:9107 npm run cypress:open -- ",
    "cypress:run": "cypress run -b chrome --project src/__tests__/cypress",
    "cypress:run:mock": "cross-env CY_MOCK=1 BASE_URL=http://localhost:9107 npm run cypress:run -- ",
    "cypress:server:dev": "cross-env DEPLOYMENT_MODE=standalone AUTH_METHOD=internal webpack serve --color --progress --config ./config/webpack.dev.js --port 9107 --no-open",
    "cypress:server": "cd ../bff && make run PORT=4000",
    "cypress:server:bff-mock": "cd ../bff && cross-env AUTH_METHOD=internal DEV_MODE=true MOCK_K8S_CLIENT=true MOCK_OGX_CLIENT=true MOCK_PIPELINE_SERVER_CLIENT=true MOCK_S3_CLIENT=true make run PORT=4000",
    "start:default": "STYLE_THEME=patternfly-theme npm run start:dev"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^0.24.1",
    "@module-federation/runtime": "^0.21.4",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/types": "^7.4.7",
    "@rsdoctor/rspack-plugin": "^1.6.1",
    "@rspack/cli": "2.1.10",
    "@rspack/core": "2.1.10",
    "@rspack/dev-server": "^2.1.0",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react-dom": "^18.3.1",
    "@types/showdown": "^2.0.3",
    "copy-webpack-plugin": "^13.0.0",
    "concurrently": "^9.2.1",
    "core-js": "^3.40.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^5.1.0",
    "dotenv-webpack": "^8.1.1",
    "eslint-plugin-markdown": "^3.0.1",
    "expect": "^30.4.1",
    "file-loader": "^6.2.0",
    "imagemin": "^9.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "junit-report-merger": "^8.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prop-types": "^15.8.1",
    "raw-loader": "^4.0.2",
    "react-refresh": "^0.14.2",
    "regenerator-runtime": "^0.14.1",
    "rspack-merge": "^1.0.1",
    "sass": "^1.87.0",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "svg-url-loader": "^8.0.0",
    "ts-checker-rspack-plugin": "^1.5.3",
    "ts-loader": "^9.5.2",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "tslib": "^2.7.0",
    "typescript": "^5.8.2",
    "url-loader": "^4.1.1",
    "wait-on": "^7.2.0",
    "webpack": "5.104.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.2.2",
    "@openshift/dynamic-plugin-sdk": "^5.0.1",
    "@patternfly/patternfly": "~6.5.1",
    "@patternfly/react-charts": "~8.5.1",
    "@patternfly/react-component-groups": "~6.5.0",
    "@patternfly/react-core": "~6.5.1",
    "@patternfly/react-drag-drop": "~6.5.1",
    "@patternfly/react-icons": "~6.5.1",
    "@patternfly/react-styles": "~6.5.1",
    "@patternfly/react-table": "~6.5.1",
    "@patternfly/react-templates": "~6.5.1",
    "@patternfly/react-tokens": "~6.5.1",
    "@patternfly/react-topology": "~6.5.0",
    "@tanstack/react-query": "^5.90.20",
    "classnames": "^2.2.6",
    "dompurify": "^3.4.0",
    "echarts": "^5.6.0",
    "es-toolkit": "^1.44.0",
    "mod-arch-core": "^1.15.4",
    "mod-arch-shared": "^1.15.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.71.1",
    "react-router": "^7.5.2",
    "react-router-dom": "^7.6.1",
    "showdown": "^2.1.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "optionalDependencies": {
    "@babel/preset-env": "^7.26.9",
