{
  "private": true,
  "name": "@odh-dashboard/agent-ops",
  "description": "Agent Ops plugin.",
  "version": "0.0.0",
  "module-federation": {
    "name": "agentOps",
    "remoteEntry": "/remoteEntry.js",
    "authorize": true,
    "tls": false,
    "proxy": [
      {
        "path": "/agent-ops/api",
        "pathRewrite": "/api"
      },
      {
        "path": "/agent-ops/healthcheck",
        "pathRewrite": "/api/v1/healthz"
      }
    ],
    "local": {
      "host": "localhost",
      "port": 9111
    },
    "service": {
      "name": "odh-dashboard",
      "port": 8843
    }
  },
  "e2eCiTags": [
    "@AgentOpsCI"
  ],
  "exports": {
    "./extensions": "./extensions.ts"
  },
  "scripts": {
    "install:module": "npm install --prefix frontend",
    "test:contract": "npx --no-install jest --config ../contract-tests/jest.preset.js",
    "test:integration:rosa": "./scripts/test-openshell-bff-rosa.sh",
    "cypress:server:build": "cd frontend && DIST_DIR=./public-cypress DEPLOYMENT_MODE=federated npm run build",
    "cypress:server:build:coverage": "COVERAGE=true npm run cypress:server:build",
    "cypress:server": "cd frontend && serve ./public-cypress -p 9111 -s -L",
    "cypress:server:dev": "cd frontend && DEPLOYMENT_MODE=federated PORT=9111 PROXY_PORT=4021 npm run start:dev",
    "cypress:server:wait": "wait-on -i 1000 http-get://localhost:9111/healthcheck",
    "cypress:server:e2e:wait": "wait-on -i 1000 http-get://localhost:9111/api/v1/healthz",
    "cypress:server:e2e": "make dev-bff-e2e-cluster E2E_BFF_PORT=9111"
  },
  "dependencies": {
    "@odh-dashboard/internal": "*",
    "@odh-dashboard/k8s-core": "*",
    "@odh-dashboard/plugin-core": "*",
    "@odh-dashboard/ui-core": "*"
  },
  "devDependencies": {
    "@odh-dashboard/app-config": "*",
    "@odh-dashboard/contract-tests": "*",
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/tsconfig": "*"
  }
}
