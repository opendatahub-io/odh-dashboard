{
  "private": true,
  "name": "@odh-dashboard/eval-hub",
  "description": "Eval Hub plugin.",
  "version": "0.0.0",
  "module-federation": {
    "name": "evalHub",
    "remoteEntry": "/remoteEntry.js",
    "authorize": true,
    "tls": false,
    "proxy": [
      {
        "path": "/eval-hub/api",
        "pathRewrite": "/api"
      }
    ],
    "local": {
      "host": "localhost",
      "port": 9106
    },
    "service": {
      "name": "odh-dashboard",
      "port": 8043
    }
  },
  "e2eCiTags": [
    "@EvalHubCI"
  ],
  "scripts": {
    "test:contract": "cross-env BFF_MOCK_FLAGS='--mock-k8s-client --mock-evalhub-client' odh-ct-bff-consumer --bff-dir bff",
    "cypress:server:build": "cd frontend && DIST_DIR=./public-cypress DEPLOYMENT_MODE=federated pnpm run build",
    "cypress:server:build:coverage": "COVERAGE=true pnpm run cypress:server:build",
    "cypress:server": "cd frontend && serve ./public-cypress -p 9106 -s -L",
    "cypress:server:dev": "cd frontend && DEPLOYMENT_MODE=federated PORT=9106 PROXY_PORT=4002 pnpm run start:dev",
    "cypress:server:wait": "wait-on -i 1000 http-get://localhost:9106/healthcheck",
    "cypress:server:e2e:wait": "pnpm run cypress:server:wait",
    "prepare:e2e": "cd bff && go mod download",
    "cypress:server:e2e": "STATIC_ASSETS_DIR=../frontend/public-cypress make dev-bff-e2e-cluster E2E_BFF_PORT=9106",
    "lint": "cd frontend && pnpm run lint",
    "lint:fix": "cd frontend && pnpm run lint:fix",
    "test-unit": "cd frontend && pnpm run test:unit",
    "type-check": "cd frontend && pnpm run test:type-check"
  },
  "dependencies": {
    "@odh-dashboard/internal": "workspace:*",
    "@odh-dashboard/plugin-core": "workspace:*",
    "@odh-dashboard/ui-core": "workspace:*"
  },
  "devDependencies": {
    "@odh-dashboard/app-config": "workspace:*",
    "@odh-dashboard/contract-tests": "workspace:*",
    "@odh-dashboard/eslint-config": "workspace:*",
    "@odh-dashboard/tsconfig": "workspace:*"
  }
}
