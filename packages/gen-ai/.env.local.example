# This file serves as an example environment configuration for local development.
# Copy this file to `.env.local` (not committed) and modify the values as needed.

# Application Environment
APP_ENV=local

# Deployment mode (standalone or integrated)
DEPLOYMENT_MODE=standalone

# LlamaStack API URL - point to your local or remote LlamaStack instance
LLAMA_STACK_URL=http://localhost:8321

# Optional override for the public Data Science Gateway hostname. `make dev-start`
# derives this from the current `oc` context by default. Set it only when discovery
# is unavailable or you need to use a different reachable gateway.
# GATEWAY_DOMAIN=rh-ai.apps.<your-cluster-domain>

# OGX and PostgreSQL images are discovered from the installed RHOAI/ODH operator CSV.
# Uncomment these only to override discovery. Set RHOAI_SUBSCRIPTION_NAMESPACE if the
# RHOAI Subscription cannot be found automatically.
# RELATED_IMAGE_ODH_OGX_CORE_IMAGE=registry.redhat.io/rhoai/odh-ogx-core-rhel9@sha256:<digest>
# RELATED_IMAGE_POSTGRESQL_16_IMAGE=registry.redhat.io/rhel9/postgresql-16@sha256:<digest>
# RHOAI_SUBSCRIPTION_NAMESPACE=redhat-ods-operator
# RHOAI_SUBSCRIPTION_PACKAGE=rhods-operator

# Optional override for the MaaS API URL used by a locally started MaaS BFF.
# Leave unset to use the MaaS BFF's cluster discovery.
# Gen AI model/token requests go through the MaaS BFF, configured separately
# via BFF_MAAS_DEV_URL for local development.
# MAAS_URL=https://maas.apps.<your-cluster-domain>/maas-api

# Local Cypress E2E workflow:
# `turbo run cypress:server:e2e` starts the MaaS BFF on port 9104.
# Uncomment this override to let the local Gen AI BFF call it.
# Keep MAAS_URL above pointing to the upstream MaaS gateway, not the local BFF.
# BFF_MAAS_DEV_URL=http://localhost:9104/api/v1
# The E2E Makefile target sets outgoing MaaS authentication to Authorization
# with the "Bearer " prefix (including the trailing space).

# NeMo Guardrails service URL for content moderation (input/output safety checks).
# On-cluster the BFF auto-discovers this from the NemoGuardrails CR, but if running local bff
# you can set this value so that `make dev-portforward` auto port-forwards (if it points to localhost)
# to the service in the cluster, using PLAYGROUND_NAMESPACE for the target namespace
NEMO_GUARDRAILS_URL=https://localhost:9443
# Alternatively you can point to an externally accessible URL for the Guardrails service
# NEMO_GUARDRAILS_URL=https://some-nemo-guardrails-openshift-dev-instance.com

# Skip TLS certificate verification - set to true when using TLS backend via port-forward
INSECURE_SKIP_VERIFY=false

# MLflow configuration — choose the workflow that matches how you start the servers.
# MLFLOW_URL is the tracking server URL, not the MLflow BFF URL.
# BFF_MLFLOW_DEV_URL is the MLflow BFF API URL for inter-BFF requests.

# 1. Local seeded development (default)
# MOCK_MLFLOW_CLIENT=true starts the full stack on `make dev-start`:
#   tracking server :5001 (seeded prompts + MCP registry) and MLflow BFF :4020.
# `make dev-start-mock` and `make dev-start-mlflow` set this automatically.
# If MLflow is already running on :5001 (e.g. from `make mlflow-up`), BFF reuses it.
MOCK_MLFLOW_CLIENT=true
MLFLOW_URL=http://localhost:5001

# 2. Local Cypress E2E with real cluster resources
# `turbo run cypress:server:e2e` starts the MLflow BFF on port 9110.
# The Gen AI E2E target forces MOCK_MLFLOW_CLIENT=false; the local seeded stack
# above is not started by that target. Uncomment these inter-BFF settings:
# BFF_MLFLOW_DEV_URL=http://localhost:9110/api/v1
# BFF_MLFLOW_AUTH_TOKEN_HEADER=Authorization
# BFF_MLFLOW_AUTH_TOKEN_PREFIX="Bearer "
# The space after Bearer is required and must be preserved by the BFF Makefile.
# Configure the tracking server separately (see below), including in
# packages/mlflow/.env.local for the MLflow BFF's upstream connection.

# 3. Real cluster tracking server (instead of the local seeded server)
# Set MOCK_MLFLOW_CLIENT=false and replace the active MLFLOW_URL above with a
# reachable tracking server URL. Use the scheme and service port your cluster exposes.
# MLFLOW_NAMESPACE is used by workflows that support MLflow namespace configuration;
# it does not by itself start a tracking-server port-forward in the E2E test.
# MOCK_MLFLOW_CLIENT=false
# MLFLOW_NAMESPACE=redhat-ods-applications
# Example for a tracking service exposing HTTPS on port 8443:
#   oc port-forward -n <mlflow namespace> svc/mlflow 5001:8443
# MLFLOW_URL=https://localhost:5001
# For development with an untrusted certificate, set INSECURE_SKIP_VERIFY=true.
# If the tracking service exposes HTTP instead, use http:// and its HTTP service port.

# Namespace for make deploy-k8s-mcp (fixed: mcp-servers)

# Kubernetes MCP server Route URL — run `make deploy-k8s-mcp` once to deploy the server to the
# cluster; it will print the URL to copy here. BFF registers it in the MLflow MCP registry on startup.
# KUBERNETES_MCP_SERVER_URL=https://kubernetes-mcp-server-mcp-servers.apps.<cluster-domain>/mcp

# Docker distribution name for LlamaStack
DISTRIBUTION_NAME=quay.io/opendatahub/llama-stack:latest

# This should be the k8s namespace where "lsd-genai-playground-service" service is deployed in cluster you are using (used in port-forwarding)
# Also used to create a matching MLflow workspace and seed it with prompts + MCP registry entries
# alongside the default workspace.
# PLAYGROUND_NAMESPACE=default
PLAYGROUND_NAMESPACE=crimson-dev

# OTel tracing — set to enable BFF span export to our gen-ai tracing collector
# Requires port-forward: 
#   for rhoai: oc port-forward svc/gen-ai-trace-collector-collector -n redhat-ods-monitoring 4318:4318
#   for odh: oc port-forward svc/gen-ai-trace-collector-collector -n opendatahub 4318:4318
# Note: the gen-ai collector service only exists after a tracing-enabled playground is installed
# (EnsureRoute creates the CR on first use), so for local testing, on first install you would need 
# start the port-forward once the gen-ai tracing collector has been created.
# Leave commented out to disable tracing (opt-in); in-cluster the BFF auto-discovers the collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ASR model endpoint for local development (Whisper/audio-transcription model)
# KServe InferenceServices use headless services that don't work with `oc port-forward svc/`.
# Create a regular ClusterIP Service in your namespace that selects the ASR model pods
# (selector: app: isvc.<model-name>-predictor) and exposes port 8080.
# Then set ASR_SERVICE_NAME to that proxy service name.
# ASR_MODEL_URL=http://localhost:8790

# ASR proxy service name for automatic port-forwarding via `make dev-portforward`
# ASR_SERVICE_NAME=<your-proxy-service-name>
# ASR_LOCAL_PORT=8790
