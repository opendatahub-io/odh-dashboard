    "test-unit-coverage": "jest --silent --coverage"
  },
  "dependencies": {
    "micromatch": "^4.0.8"
  },
  "peerDependencies": {
    "eslint": "^8.0.0"
  },
  "devDependencies": {
    "@odh-dashboard/eslint-config": "workspace:*",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0"
  }
}

