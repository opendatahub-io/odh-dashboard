{
  "name": "@odh-dashboard/eslint-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "ODH Dashboard custom ESLint plugin",
  "type": "commonjs",
  "main": "./index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
