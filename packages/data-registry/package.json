{
  "private": true,
  "name": "@odh-dashboard/data-registry",
  "description": "Data Registry plugin.",
  "version": "0.0.0",
  "module-federation": {
    "name": "dataRegistry",
    "remoteEntry": "/remoteEntry.js",
    "authorize": true,
    "tls": false,
    "proxy": [
      {
        "path": "/data-registry/api",
        "pathRewrite": "/api"
      }
    ],
    "local": {
      "host": "localhost",
      "port": 9103
    },
    "service": {
      "name": "odh-dashboard-data-registry-ui",
      "port": 9043
    }
  },
  "exports": {
    "./extensions": "./extensions.ts"
  },
  "bffConfig": {
    "enabled": true,
    "port": 8080,
    "healthEndpoint": "/healthcheck",
    "startCommand": "make dev-bff-e2e-mock"
  },
  "scripts": {
    "test:contract": "BFF_MOCK_FLAGS='--mock-k8s-client --auth-method=user_token' odh-ct-bff-consumer --bff-dir bff",
    "cypress:server:build": "cd frontend && DIST_DIR=./public-cypress DEPLOYMENT_MODE=federated pnpm run build",
    "cypress:server:build:coverage": "COVERAGE=true pnpm run cypress:server:build",
    "cypress:server": "cd frontend && serve ./public-cypress -p 9103 -s -L",
    "cypress:server:dev": "cd frontend && DEPLOYMENT_MODE=federated PORT=9103 pnpm run start:dev",
    "cypress:server:wait": "pnpm exec wait-on -i 1000 http://localhost:9103"
  },
  "dependencies": {
    "@odh-dashboard/internal": "workspace:*",
    "@odh-dashboard/plugin-core": "workspace:*"
  },
  "devDependencies": {
    "@odh-dashboard/app-config": "workspace:*",
    "@odh-dashboard/contract-tests": "workspace:*",
    "@odh-dashboard/eslint-config": "workspace:*",
    "@odh-dashboard/tsconfig": "workspace:*"
  }
}
