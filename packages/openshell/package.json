{
  "private": true,
  "name": "@odh-dashboard/openshell",
  "description": "OpenShell plugin.",
  "version": "0.0.0",
  "module-federation": {
    "name": "openshell",
    "remoteEntry": "/remoteEntry.js",
    "authorize": true,
    "tls": false,
    "proxy": [
      {
        "path": "/openshell/api",
        "pathRewrite": "/api"
      },
      {
        "path": "/openshell/healthcheck",
        "pathRewrite": "/healthcheck"
      }
    ],
    "local": {
      "host": "localhost",
      "port": 9109
    },
    "service": {
      "name": "odh-dashboard",
      "port": 8943
    }
  },
  "exports": {
    "./extensions": "./extensions.ts"
  },
  "scripts": {
    "install:module": "npm install --prefix frontend",
    "cypress:server:build": "cd frontend && DIST_DIR=./public-cypress DEPLOYMENT_MODE=federated npm run build",
    "cypress:server:build:coverage": "COVERAGE=true npm run cypress:server:build",
    "cypress:server": "cd frontend && serve ./public-cypress -p 9109 -s -L",
    "cypress:server:dev": "cd frontend && DEPLOYMENT_MODE=federated PORT=9109 PROXY_PORT=4022 npm run start:dev",
    "cypress:server:wait": "wait-on -i 1000 http-get://localhost:9109/healthcheck",
    "cypress:server:e2e:wait": "npm run cypress:server:wait",
    "prepare:e2e": "cd bff && go mod download",
    "cypress:server:e2e": "STATIC_ASSETS_DIR=../frontend/public-cypress make dev-bff-e2e-cluster E2E_BFF_PORT=9109",
    "lint": "cd frontend && npm run lint",
    "lint:fix": "cd frontend && npm run lint:fix"
  },
  "dependencies": {
    "@odh-dashboard/internal": "*",
    "@odh-dashboard/plugin-core": "*",
    "@odh-dashboard/ui-core": "*"
  },
  "devDependencies": {
    "@odh-dashboard/app-config": "*",
    "@odh-dashboard/contract-tests": "*",
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/tsconfig": "*"
  }
}
