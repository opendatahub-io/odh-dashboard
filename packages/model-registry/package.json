{
  "private": true,
  "name": "@odh-dashboard/model-registry",
  "description": "Model registry plugin for managing ML models.",
  "version": "0.0.0",
  "scripts": {
    "install:module": "if [ \"$MODULE_CACHE_HIT\" = \"true\" ] && [ -d upstream/frontend/node_modules ]; then echo 'Using cached model-registry upstream dependencies'; else npm install --prefix upstream/frontend --no-audit --no-fund; fi",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "update-subtree": "package-subtree --package=@odh-dashboard/model-registry",
    "update-subtree-local": "package-subtree-local --package=@odh-dashboard/model-registry",
    "test:contract": "odh-ct-bff-consumer --bff-dir upstream/bff",
    "cypress:server:build": "npm run install:module && cd upstream/frontend && cross-env DIST_DIR=./public-cypress POLL_INTERVAL=9999999 DEPLOYMENT_MODE=federated npm run build",
    "cypress:server:build:coverage": "cross-env COVERAGE=true npm run cypress:server:build",
    "cypress:server": "cd upstream/frontend && serve ./public-cypress -p 9100 -s -L",
    "cypress:server:dev": "cd upstream/frontend && cross-env DEPLOYMENT_MODE=federated PORT=9100 PROXY_PORT=4000 npm run start:dev",
    "cypress:server:wait": "wait-on -i 1000 http-get://localhost:9100/healthcheck",
    "cypress:server:e2e:wait": "npm run cypress:server:wait",
    "prepare:e2e": "cd upstream/bff && go mod download",
    "cypress:server:e2e": "STATIC_ASSETS_DIR=../frontend/public-cypress make -C upstream dev-bff-e2e-cluster E2E_BFF_PORT=9100",
    "start:dev": "cd upstream && cross-env PORT=9100 make dev-start-federated",
    "start:dev:ext": "cd upstream/frontend && cross-env DEPLOYMENT_MODE=federated PORT=9100 npm run start:dev",
    "start:dev:wait": "wait-on -i 1000 http://localhost:9100"
  },
  "subtree": {
    "repo": "https://github.com/kubeflow/model-registry.git",
    "branch": "main",
    "src": "clients/ui",
    "target": "upstream",
    "commit": "11f57437c4e21fd408445bfa752820055ffbe3aa"
  },
  "module-federation": {
    "name": "modelRegistry",
    "remoteEntry": "/remoteEntry.js",
    "authorize": true,
    "tls": false,
    "proxy": [
      {
        "path": "/model-registry/api",
        "pathRewrite": "/api"
      }
    ],
    "local": {
      "host": "localhost",
      "port": 9100
    },
    "service": {
      "name": "odh-dashboard",
      "port": 8043
    }
  },
  "e2eCiTags": [
    "@ModelRegistryCI",
    "@ModelCatalogCI"
  ],
  "exports": {
    "./extensions": "./extensions.ts",
    "./shared": "./shared/index.ts",
    "./mocks/*": [
      "./upstream/frontend/src/__mocks__/*",
      "./upstream/frontend/src/__mocks__/*.ts"
    ],
    "./types/modelCatalogTypes": "./upstream/frontend/src/app/modelCatalogTypes.ts",
    "./types/mcpDeploymentTypes": "./upstream/frontend/src/odh/types/mcpDeploymentTypes.ts",
    "./types/types": "./upstream/frontend/src/app/types.ts",
    "./routeUtils": "./upstream/frontend/src/app/pages/modelRegistry/screens/routeUtils.ts"
  },
  "dependencies": {
    "@odh-dashboard/internal": "workspace:*",
    "@odh-dashboard/k8s-core": "workspace:*",
    "@odh-dashboard/model-serving": "workspace:*",
    "@odh-dashboard/plugin-core": "workspace:*",
    "@odh-dashboard/ui-core": "workspace:*"
  },
  "devDependencies": {
    "@odh-dashboard/app-config": "workspace:*",
    "@odh-dashboard/contract-tests": "workspace:*",
    "@odh-dashboard/eslint-config": "workspace:*",
    "@odh-dashboard/jest-config": "workspace:*",
    "@odh-dashboard/tsconfig": "workspace:*"
  },
  "peerDependencies": {
    "@openshift/dynamic-plugin-sdk": "^5",
    "@patternfly/react-core": "^6",
    "@patternfly/react-icons": "^6",
    "react": "^18",
    "react-dom": "^18"
  }
}
