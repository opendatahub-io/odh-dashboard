{
  "private": true,
  "name": "@odh-dashboard/ai-safety",
  "description": "AI Safety Studio plugin.",
  "version": "0.0.0",
  "module-federation": {
    "name": "aiSafety",
    "remoteEntry": "/remoteEntry.js",
    "authorize": true,
    "tls": false,
    "proxy": [
      {
        "path": "/ai-safety/api",
        "pathRewrite": "/api"
      },
      {
        "path": "/ai-safety/healthcheck",
        "pathRewrite": "/healthcheck"
      }
    ],
    "local": {
      "host": "localhost",
      "port": 9114
    },
    "service": {
      "name": "odh-dashboard-ai-safety-ui",
      "port": 9343
    }
  },
  "scripts": {
    "cypress:mock:build": "pnpm run cypress:server:build",
    "cypress:mock:build:coverage": "pnpm run cypress:server:build:coverage",
    "cypress:mock:dev": "pnpm run cypress:server:dev",
    "cypress:server:build": "cd frontend && DIST_DIR=./public-cypress DEPLOYMENT_MODE=federated pnpm run build",
    "cypress:server:build:coverage": "COVERAGE=true pnpm run cypress:server:build",
    "cypress:server": "cd frontend && serve ./public-cypress -p 9114 -s -L",
    "cypress:server:dev": "cd frontend && DEPLOYMENT_MODE=federated PORT=9114 PROXY_PORT=4006 pnpm run start:dev",
    "cypress:server:wait": "pnpm exec wait-on -i 1000 http-get://localhost:9114/healthcheck",
    "cypress:server:e2e:wait": "pnpm run cypress:server:wait",
    "prepare:e2e": "cd bff && go mod download",
    "cypress:server:e2e": "STATIC_ASSETS_DIR=../frontend/public-cypress make dev-bff-e2e-cluster E2E_BFF_PORT=9114",
    "lint": "cd frontend && pnpm run test:lint",
    "lint:fix": "cd frontend && pnpm run test:fix",
    "test-unit": "cd frontend && pnpm run test:unit",
    "type-check": "cd frontend && pnpm run test:type-check"
  },
  "dependencies": {
    "@odh-dashboard/internal": "workspace:*",
    "@odh-dashboard/plugin-core": "workspace:*",
    "@odh-dashboard/ui-core": "workspace:*"
  },
  "devDependencies": {
    "@odh-dashboard/app-config": "workspace:*",
    "@odh-dashboard/eslint-config": "workspace:*",
    "@odh-dashboard/tsconfig": "workspace:*",
    "eslint-plugin-n": "^17.23.1"
  }
}
