ODH_DASHBOARD_URL: "http://odh-dashboard-opendatahub.apps.my-cluster.test.redhat.com"
PRODUCT: ODH
ODH_DASHBOARD_PROJECT_NAME: Open Data Hub
APPLICATIONS_NAMESPACE: opendatahub
MONITORING_NAMESPACE: opendatahub
OPERATOR_NAMESPACE: openshift-operators
NOTEBOOKS_NAMESPACE: opendatahub

TEST_USER:
  AUTH_TYPE: foo-auth
  USERNAME: foo-user
  PASSWORD: foo-passwd
TEST_USER_3:
  AUTH_TYPE: contributor-auth
  USERNAME: contributor-username
  PASSWORD: contributor-passwd
TEST_USER_5:
  AUTH_TYPE: cluster-admin-auth
  USERNAME: cluster-admin-username
  PASSWORD: cluster-admin-passwd
OCP_ADMIN_USER:
  AUTH_TYPE: adm-auth
  USERNAME: adminuser
  PASSWORD: adminuser-passwd
S3:
  AWS_ACCESS_KEY_ID: access_key
  AWS_SECRET_ACCESS_KEY: secret_key
  # PEM-encoded CA the S3 endpoint is served with. On disconnected clusters the pipeline
  # sets this (and rewrites the BUCKET endpoints) to the injected MinIO. Leave empty for AWS.
  # AWS_CA_BUNDLE: |
  #   -----BEGIN CERTIFICATE-----
  #   ...
  #   -----END CERTIFICATE-----
  BUCKET_1:
    NAME: bucket-1-name
    REGION: bucket-1-region
    ENDPOINT: https://bucket1-endpoint.com/
  BUCKET_2:
    NAME: pipeline-bucket-name
    REGION: pipeline-bucket-region
    ENDPOINT: https://pipeline-bucket-endpoint.com/
  BUCKET_3:
    NAME: model-bucket-name
    REGION: model-bucket-region
    ENDPOINT: https://model-bucket-endpoint.com/

# Feature Store registry uses S3.BUCKET_1 via an AWS CLI pod. On disconnected clusters the
# pipeline points BUCKET_1 (and AWS_CA_BUNDLE) at the injected MinIO; no test change needed.
# Optional mirrored AWS CLI image for disconnected clusters:
# AWS_CLI_IMAGE: registry.example.com/mirror/amazon/aws-cli@sha256:<digest>

PIP_INDEX_URL: https://pypi.org/simple
PIP_TRUSTED_HOST: pypi.org
NGC_API_KEY: bm90IGEgdmFsaWQgYXBpIGtleQo=
OCI_SECRET_VALUE: cmhvYWlfZGFzaGJvYXJkK3Job
OCI_MODEL_URI: quay.io/my_user/my_oci_model:latest
MAAS_URL: https://maas.apps.your-cluster.com
MAAS_API_KEY: your-api-key-here
MAAS_GENERATION_MODEL_ID: your-generation-model-id
MAAS_EMBEDDING_MODEL_ID: your-embedding-model-id
