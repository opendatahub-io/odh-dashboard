    "./ui/components/feature": "./ui/src/components/feature/index.ts",
    "./ui/utils": "./ui/src/utils/index.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 --ext .js,.ts,.jsx,.tsx ./ui/src ./ui/*.js",
    "lint:fix": "eslint --ext .js,.ts,.jsx,.tsx ./ui/src ./ui/*.js --fix",
    "type-check": "tsc --noEmit -p ui/tsconfig.json",
    "test-unit": "jest --config ui/jest.config.js --passWithNoTests",
    "test-unit-coverage": "jest --config ui/jest.config.js --coverage --passWithNoTests"
  },
  "dependencies": {
    "@odh-dashboard/internal": "*",
    "@odh-dashboard/plugin-core": "*",
