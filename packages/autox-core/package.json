    "@patternfly/react-styles": "^6",
    "@patternfly/react-table": "^6",
    "@patternfly/react-topology": "^6",
    "@tanstack/react-query": "^5.90.20",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.71.1",
    "react-router": "^7",
    "react-router-dom": "^7",
    "zod": "^4"
