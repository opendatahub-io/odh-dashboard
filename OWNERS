# Filters are additive: every matching filter contributes approvers, reviewers, and labels.
# Package ownership lives in packages/<pkg>/OWNERS and manifest module ownership in
# manifests/modules/<module>/OWNERS (both with options.no_parent_owners: true).
# Root filters cover the remaining path-based areas.
filters:
  # Allow team approvers to approve changes to their own sections in OWNERS_ALIASES
  'OWNERS_ALIASES':
    approvers:
      - general-approvers
      - managers-backup-approvers
      - ai-trusty-approvers
      - connections-approvers
      - hardware-profiles-approvers
      - model-registry-catalog-approvers
      - model-serving-metrics-approvers
      - maas-approvers
      - pipelines-approvers
      - platform-approvers
      - quality-e2e-testing-approvers
      - workbenches-approvers
      - gen-ai-approvers
      - nim-serving-approvers
      - autorag-approvers
      - automl-approvers
      - eval-hub-approvers
      - data-registry-approvers
      - mlflow-approvers
      - distributions-approvers

  # Catchall for shared/root files and any path without a more specific owner.
  '.*':
    approvers:
      - openshift-cherrypick-robot
      - general-approvers
      - managers-backup-approvers

  'backend/.*':
    labels:
      - area/backend

  'docs/.*':
    reviewers:
      - platform-reviewers
    labels:
      - area/docs

  'frontend/.*':
    labels:
      - area/frontend

  # Only labels packages that do not have their own packages/<pkg>/OWNERS yet.
  'packages/.*':
    labels:
      - area/components

  # Model Registry / Catalog
  'frontend/src/(api|concepts|pages|routes)/(modelCatalog|modelRegistry|modelRegistrySettings)/.*':
    approvers:
      - model-registry-catalog-approvers
    reviewers:
      - model-registry-catalog-reviewers
    labels:
      - area/model-registry

  # Model Serving
  'frontend/src/(api|concepts|pages)/(modelServing|modelServingKServe)/.*':
    approvers:
      - model-serving-metrics-approvers
    reviewers:
      - model-serving-metrics-reviewers
    labels:
      - area/model-serving

  # Tooling & Plugins
  'frontend/src/plugins/.*':
    approvers:
      - platform-approvers
    reviewers:
      - platform-reviewers
    labels:
      - area/platform

  # Pipelines
  'frontend/src/(api|concepts|pages|routes)/pipelines/.*':
    approvers:
      - pipelines-approvers
    reviewers:
      - pipelines-reviewers
    labels:
      - area/pipelines

  # TrustyAI
  'frontend/src/(api|concepts|pages)/trustyai/.*':
    approvers:
      - ai-trusty-approvers
    reviewers:
      - ai-trusty-reviewers
    labels:
      - area/ai-safety-trusty

  # Distributed Workloads
  'frontend/src/(concepts|pages)/distributedWorkloads/.*':
    labels:
      - area/distributed-workloads

  # Connections
  'frontend/src/(concepts|pages)/connectionTypes/.*':
    approvers:
      - connections-approvers
    reviewers:
      - connections-reviewers
    labels:
      - area/connections

  # Accelerator / Profiles
  'frontend/src/(api|concepts)/(acceleratorProfiles|hardwareProfiles)/.*':
    approvers:
      - hardware-profiles-approvers
    reviewers:
      - hardware-profiles-reviewers
    labels:
      - area/hardware-profiles

  # Workbenches
  'frontend/src/(api|concepts)/(notebooks|notebookController)/.*':
    approvers:
      - workbenches-approvers
    reviewers:
      - workbenches-reviewers
    labels:
      - area/workbenches
