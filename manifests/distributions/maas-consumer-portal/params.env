# Injected by the Dashboard Module Controller. gateway-domain is the shared
# gateway hostname; maas-consumer-portal-url is the portal's HTTPS path URL.
core-bff-image=quay.io/opendatahub/odh-core-bff:main
dashboard-namespace=
gateway-name=
maas-consumer-portal-url=
# Must be the generated portal federation ConfigMap name
# (maas-consumer-portal-federation-config), mounted by Core-BFF at
# /etc/odh-dashboard/maas-consumer-portal-federation-config.json.
maas-consumer-portal-federation-config=
gateway-domain=
section-title=
