# This bundle is intentionally not wired to dashboard-operator yet. Future
# operator integration must supply the production image and XKS auth Gateway
# identity explicitly.
rhaii-dashboard-image=quay.io/opendatahub/rhaii-dashboard:main
# Defaults follow the XKS platform auth Gateway convention: PR #161 supplies
# rh-ai-gateway, and GatewayConfig reconciles data-science-gateway there. The
# HTTPRoute remains unaccepted until that Gateway is provisioned.
gateway-name=data-science-gateway
gateway-namespace=rh-ai-gateway
