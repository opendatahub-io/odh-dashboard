# The related-image environment variable supplied by release automation
# overrides this usable development fallback, following the RHOAI bundle
# convention.
rhaii-dashboard-image=quay.io/opendatahub/rhaii-dashboard:main
# The installer must set this to the namespace where it applies the bundle.
# It is used by RoleBinding and ClusterRoleBinding ServiceAccount subjects.
rhaii-dashboard-namespace=default
# Defaults follow the XKS platform auth Gateway convention: odh-gitops PR #161
# provisions the rh-ai-gateway Gateway in the rh-ai-gateway namespace. The
# HTTPRoute remains unaccepted until that Gateway is provisioned.
gateway-name=rh-ai-gateway
gateway-namespace=rh-ai-gateway
