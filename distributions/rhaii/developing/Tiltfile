# RHAII Distribution — Tilt Development Environment
#
# Usage:
#   make tilt-up     # creates kind cluster, installs KServe, and starts the full stack
#   make tilt-down   # stops Tilt
#
# Prerequisites: docker/podman, kind, tilt, curl, go

analytics_settings(False)
version_settings(check_updates=True, constraint=">=0.33.0")
update_settings(k8s_upsert_timeout_secs=120)

# Allow the kind-tilt context (created by setup-kind.sh)
allow_k8s_contexts("kind-rhaii-tilt")

# ── Paths ─────────────────────────────────────────────────────────────────────

tilt_root = os.path.dirname(os.path.abspath(__file__))

# Go up from developing/ -> rhaii/ -> distributions/ -> repo root
dist_root = os.path.join(tilt_root, "..")
repo_root = os.path.join(tilt_root, "../../..")

# ── Federated model serving ──────────────────────────────────────────────────

build_args = {
    "MODEL_SERVING_REMOTE_ENTRY": "http://localhost:9109/remoteEntry.js",
    "RHAII_TILT_FIXTURES": "true",
}

# ── RHAII Dashboard ───────────────────────────────────────────────────────────

# File-watch scope for the image build: the whole repo-root build context
# (matching the Dockerfile COPY layers), minus vendored and generated output.
# Used by both build paths below; in custom_build, ignore patterns are
# evaluated relative to each entry in deps.
build_ignore = [
    "distributions/rhaii/node_modules",
    "distributions/rhaii/public",
    "distributions/rhaii/developing",
    "distributions/base/public",
    "distributions/base/node_modules",
    "distributions/core-bff/bff/bin",
    "node_modules",
    "frontend/node_modules",
    "packages/*/node_modules",
    "**/*.md",
]

# Tilt's docker_build needs BuildKit's gRPC session, which Podman's
# Docker-compatible API does not implement ("unable to upgrade to h2c,
# received 404"). On a Podman daemon, build via the legacy CLI instead;
# otherwise keep the native docker_build.
#
# A DOCKER_HOST at Podman's compat socket also identifies the daemon on
# podman-only installs without a docker CLI.
docker_host = os.environ.get("DOCKER_HOST", "")
docker_cli = str(local("command -v docker 2>/dev/null || true", quiet=True)) != ""
if "podman" in docker_host:
    podman_daemon = True
elif docker_cli:
    podman_daemon = "Podman Engine" in str(local("docker version 2>&1 || true", quiet=True))
else:
    podman_daemon = False

def shell_quote(value):
    return "'" + value.replace("'", "'\"'\"'") + "'"

quoted_repo_root = shell_quote(repo_root)
quoted_dockerfile = shell_quote(os.path.join(dist_root, "Dockerfile"))

if podman_daemon:
    # Endpoint the docker CLI would resolve: DOCKER_HOST, else the current
    # Docker context's endpoint. Podman does not read either, so it is
    # forwarded as CONTAINER_HOST below to keep build and push on the same
    # Podman connection/image store.
    docker_endpoint = docker_host
    if docker_cli and not docker_endpoint:
        docker_endpoint = str(local(
            "docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null || true",
            quiet=True,
        )).strip()
    podman_env = "CONTAINER_HOST=%s " % shell_quote(docker_endpoint) if docker_endpoint else ""
    podman_cli = str(local("command -v podman 2>/dev/null || true", quiet=True)) != ""
    if docker_cli:
        # The docker CLI resolves the same endpoint as Tilt's client (DOCKER_HOST /
        # Docker contexts), so build through it. Pushing through it is not an
        # option: Podman's compat API enforces TLS even for localhost registries
        # ("server gave HTTP response to HTTPS client"), so push via the podman
        # CLI with --tls-verify=false, pinned to the same endpoint via
        # CONTAINER_HOST. Without a podman CLI there is no way to push to the
        # plain-HTTP registry at all — fail loudly instead of with the cryptic
        # TLS error.
        build_binary = "DOCKER_BUILDKIT=0 docker"
        push_command = (
            podman_env + "podman push --tls-verify=false \"$ref\""
            if podman_cli
            else (
                "echo \"ERROR: the daemon is Podman, which requires the podman CLI to push "
                + "to the insecure local registry; install podman or mark localhost:5001 "
                + "insecure in the daemon's containers-registries.conf\" >&2; exit 1"
            )
        )
    else:
        # Podman-only install: build and push through the podman CLI, pinned to
        # the endpoint the daemon was detected on.
        build_binary = podman_env + "podman"
        push_command = podman_env + "podman push --tls-verify=false \"$ref\""
    # Tilt's push would go through the Docker API, which cannot mark the
    # plain-HTTP local registry insecure; push via the CLI instead and use
    # skips_local_docker to stop Tilt from pushing (or kind-loading) itself.
    custom_build(
        "rhaii-dashboard",
        command=(
            "cd " + quoted_repo_root + " && "
            # $EXPECTED_REF is registry-qualified ("localhost:5001/rhaii-dashboard:tilt-...")
            # when Kind runs a local registry. Without one there is nowhere to push
            # (skips_local_docker disables Tilt's kind-load fallback, which is broken
            # on Podman: any `ctr images import --snapshotter=...` fails with
            # "no unpack platforms defined" on current kindest/node images —
            # cf. kubernetes-sigs/kind#3945, closed but still reproducible), so fail loudly.
            + 'ref="$EXPECTED_REF"; case "$ref" in localhost:*) ;; *) echo "ERROR: no local registry detected; run scripts/setup-kind.sh before tilt up" >&2; exit 1;; esac; '
            + build_binary
            + " build -t \"$ref\""
            + "".join([
                " --build-arg %s=%s" % (key, shell_quote(value))
                for key, value in build_args.items()
            ])
            + " -f " + quoted_dockerfile + " ."
            + " && "
            + push_command
        ),
        deps=[repo_root],
        ignore=build_ignore,
        skips_local_docker=True,
    )
else:
    docker_build(
        "rhaii-dashboard",
        context=repo_root,
        dockerfile=os.path.join(dist_root, "Dockerfile"),
        build_args=build_args,
        ignore=build_ignore,
    )

k8s_yaml(kustomize(os.path.join(tilt_root, "manifests")))
k8s_yaml(os.path.join(tilt_root, "manifests/model-serving-demo.yaml"))
k8s_yaml(os.path.join(tilt_root, "manifests/model-serving-demo-rbac.yaml"))

k8s_resource(
    "rhaii-dashboard",
    port_forwards=[port_forward(4000, 4000, name="RHAII Dashboard")],
    resource_deps=["model-serving-remote"],
    labels=["rhaii"],
)

# ── Model Serving (KServe backend) ───────────────────────────────────────────

node_bin = os.environ.get("NVM_BIN", "")
remote_env = {}
if node_bin:
    remote_env["PATH"] = node_bin + ":" + os.environ.get("PATH", "")

model_serving_frontend = os.path.join(repo_root, "packages/model-serving/frontend")
quoted_model_serving_frontend = shell_quote(model_serving_frontend)
local_resource(
    "workspace-install",
    cmd="pnpm --dir " + quoted_repo_root + " install --ignore-scripts",
    labels=["model-serving"],
)
local_resource(
    "model-serving-remote",
    serve_cmd="cd " + quoted_model_serving_frontend + " && AUTH_METHOD=internal DEPLOYMENT_MODE=federated STYLE_THEME=patternfly PORT=9109 PROXY_PORT=4000 _DEV_SERVER_ALLOWED_ORIGIN=http://localhost:4000 pnpm run start:dev",
    serve_env=remote_env,
    resource_deps=["workspace-install"],
    readiness_probe=probe(http_get=http_get_action(port=9109, path="/remoteEntry.js")),
    labels=["model-serving"],
)

# Track readiness of the externally-installed KServe controllers.
local_resource(
    "kserve-controller",
    cmd="kubectl wait --for=condition=Available --timeout=300s -n kserve deployment/kserve-controller-manager",
    labels=["model-serving"],
)
local_resource(
    "llmisvc-controller",
    cmd="kubectl wait --for=condition=Available --timeout=300s -n kserve deployment/llmisvc-controller-manager",
    labels=["model-serving"],
)
