{
  "name": "@odh-dashboard/rhaii-distribution",
  "version": "0.0.0",
  "description": "RHAII distribution — composes the base app shell with RHAII-specific plugins",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run start:dev",
    "start:dev": "concurrently -k -n bff,shell \"make -C ../core-bff dev-bff\" \"rspack dev --hot --config ./config/rspack.dev.js\"",
    "build": "rspack --config ./config/rspack.prod.js",
    "build:prod": "rspack --config ./config/rspack.prod.js",
    "test-unit": "jest --silent",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@odh-dashboard/k8s-core": "*",
    "@odh-dashboard/model-serving": "*",
    "@odh-dashboard/plugin-core": "*",
    "@odh-dashboard/ui-core": "*",
    "@openshift/dynamic-plugin-sdk": "^5.0.1",
    "@openshift/dynamic-plugin-sdk-utils": "^5.0.0",
    "@patternfly/patternfly": "~6.5.2",
    "@patternfly/react-code-editor": "~6.5.1",
    "@patternfly/react-core": "~6.5.1",
    "@patternfly/react-icons": "~6.5.1",
    "@patternfly/react-styles": "~6.5.1",
    "@patternfly/react-table": "~6.5.1",
    "lodash-es": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/jest-config": "*",
    "@odh-dashboard/tsconfig": "*",
    "@rspack/cli": "2.1.10",
    "@rspack/core": "2.1.10",
    "@rspack/dev-server": "^2.1.0",
    "concurrently": "^9.2.1",
    "css-loader": "^5.2.7",
    "file-loader": "^6.2.0",
    "raw-loader": "^4.0.2",
    "rspack-merge": "^1.0.1",
    "sass": "^1.100.0",
    "sass-loader": "^13.3.3",
    "style-loader": "^2.0.0",
    "svg-url-loader": "^6.0.0",
    "ts-checker-rspack-plugin": "^1.5.3",
    "typescript": "^5.9.3",
    "url-loader": "^4.1.1"
  }
}
