# OWNERS

filters:
  '.*':
    approvers:
      - distributions-approvers
      - maas-approvers
      - ai-grid-approvers
    reviewers:
      - distributions-reviewers
      - maas-reviewers
      - ai-grid-reviewers
    labels:
      - area/distributions
      - area/maas

  # Dependency manifests: CVE and dependency-bump PRs. See
  # docs/adding-owners-and-reviewers.md#dependency-approvers
  '^((bff|cypress|frontend|services)/)?(package\.json|go\.(mod|sum))$':
    approvers:
      - dependency-approvers

options:
  no_parent_owners: true
