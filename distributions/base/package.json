{
  "name": "@odh-dashboard/base-distribution",
  "version": "0.0.0",
  "description": "Base app shell distribution framework",
  "license": "Apache-2.0",
  "private": true,
  "main": "./src/lib.ts",
  "exports": {
    ".": "./src/lib.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run start:dev",
    "start:dev": "concurrently -k -n bff,shell \"make -C ../core-bff dev-bff\" \"rspack dev --hot --config ./config/rspack.dev.js\"",
    "build": "rspack --config ./config/rspack.prod.js",
    "type-check": "tsc --noEmit",
    "test-unit": "jest --silent",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@odh-dashboard/plugin-core": "*",
    "@odh-dashboard/ui-core": "*",
    "@openshift/dynamic-plugin-sdk": "^5.0.1",
    "@patternfly/patternfly": "~6.5.2",
    "@patternfly/react-core": "~6.5.1",
    "@patternfly/react-icons": "~6.5.1",
    "@patternfly/react-styles": "~6.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@odh-dashboard/eslint-config": "*",
    "@odh-dashboard/tsconfig": "*",
    "@rspack/cli": "2.1.10",
    "@rspack/core": "2.1.10",
    "@rspack/dev-server": "^2.1.0",
    "css-loader": "^5.2.7",
    "file-loader": "^6.2.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "raw-loader": "^4.0.2",
    "rspack-merge": "^1.0.1",
    "sass": "^1.100.0",
    "sass-loader": "^13.3.3",
    "style-loader": "^2.0.0",
    "svg-url-loader": "^6.0.0",
    "ts-checker-rspack-plugin": "^1.5.3",
    "typescript": "^5.9.3",
    "url-loader": "^4.1.1"
  }
}
