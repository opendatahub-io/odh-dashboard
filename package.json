{
  "name": "odh-dashboard",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "private": true,
  "bin": {
    "unit-test-coverage-aggregator": "scripts/unit-test-coverage-aggregator.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opendatahub-io/odh-dashboard.git"
  },
  "homepage": "https://github.com/opendatahub-io/odh-dashboard#readme",
  "bugs": {
    "url": "https://github.com/opendatahub-io/odh-dashboard/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "run-p -l build:*",
    "build:backend": "pnpm --filter odh-dashboard-backend build",
    "build:frontend": "pnpm --filter odh-dashboard-frontend build",
    "dev": "run-p -l dev:*",
    "dev:backend": "pnpm --filter odh-dashboard-backend start:dev",
    "dev:frontend": "pnpm --filter odh-dashboard-frontend start:dev",
    "format": "prettier --write \"backend/**/*.ts\" \"frontend/**/*.ts\" \"frontend/**/*.tsx\"",
    "make": "make",
    "make:build": "make build",
    "make:deploy": "make deploy",
    "make:login": "make login",
    "make:undeploy": "make undeploy",
    "make:push": "make push",
    "start": "run-p start:*",
    "start:backend": "pnpm --filter odh-dashboard-backend start",
    "start:frontend": "echo \"...available at ./frontend/public\"",
    "test": "run-s test:backend test:frontend",
    "test:backend": "pnpm --filter odh-dashboard-backend test",
    "test:frontend": "pnpm --filter odh-dashboard-frontend test",
    "test:frontend:coverage": "pnpm --filter odh-dashboard-frontend test:coverage",
    "test:frontend:unit-coverage": "pnpm --filter odh-dashboard-frontend test:unit-coverage",
    "test:backend:unit-coverage": "pnpm --filter odh-dashboard-backend test:unit-coverage",
    "test:cypress-ci": "pnpm --filter odh-dashboard-frontend test:cypress-ci -- ",
    "test:unit": "turbo run test:unit",
    "lint:frontend:backend": "run-p test:lint:*",
    "test:lint:backend": "pnpm --filter odh-dashboard-backend test:lint",
    "test:lint:frontend": "pnpm --filter odh-dashboard-frontend test:lint",
    "test:fix": "run-s test:fix-backend test:fix-frontend",
    "test:fix-backend": "pnpm --filter odh-dashboard-backend test:fix",
    "test:fix-frontend": "pnpm --filter odh-dashboard-frontend test:fix",
    "commit:skip-lint-hook": "SKIP_LINT_HOOK=true git commit",
    "commit:force-lint-hook": "FORCE_LINT_HOOK=true git commit",
    "prepare": "husky",
    "validate:ports": "node scripts/validate-module-ports.js",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "test-unit": "turbo run test-unit",
    "test-unit-coverage": "turbo run test-unit-coverage && node scripts/unit-test-coverage-aggregator.js",
    "test:contract": "turbo run test:contract --concurrency=1",
    "cypress:server": "turbo run cypress:server --concurrency=20",
    "cypress:server:e2e": "turbo run cypress:server:e2e --concurrency=20",
    "cypress:server:dev": "turbo run cypress:server:dev",
    "cypress:server:build": "turbo run cypress:server:build",
    "cypress:server:build:coverage": "turbo run cypress:server:build:coverage",
    "install:all": "pnpm install",
    "prepare:e2e": "turbo run prepare:e2e",
    "cypress:server:e2e:wait": "turbo run cypress:server:e2e:wait",
    "test:cypress:e2e": "concurrently -P -k -s first --hide 0 \"pnpm cypress:server:e2e\" \"pnpm cypress:server:e2e:wait && cross-env CYPRESS_E2E_PROXY=true pnpm --filter odh-dashboard-frontend cypress:run:chrome -- {@}\" --",
    "start:dev": "turbo run start:dev",
    "start:dev:ext": "turbo run start:dev:ext"
  },
  "dependencies": {
    "@kubernetes/client-node": "^0.12.3",
    "@openshift/dynamic-plugin-sdk-utils": "^5.0.1",
    "@types/tar": "^6.1.13",
    "jsonpath-plus": "^10.4.0",
    "tough-cookie": "^4.1.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^0.24.1",
    "@odh-dashboard/eslint-config": "workspace:*",
    "@rspack/cli": "2.1.10",
    "@rspack/core": "2.1.10",
    "@rspack/dev-server": "^2.1.0",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.31",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "csstype": "^3.2.3",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.2",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3",
    "wait-on": "^7.2.0",
    "webpack": "5.104.1"
  },
  "lint-staged": {
    "{,+([^.])*/**/}*.{js,ts,jsx,tsx,md}": [
      "pnpm exec eslint --max-warnings 0"
    ]
  }
}
