{
  "comment": "Host-side producer registry. The stock Fullsend pr-review skill selects and runs reviewers from persona frontmatter; this file no longer drives dispatch. It names what the host needs: the cli-adapter rows pre-review.sh runs (runner, credentials), and for every producer the sticky label, output kind (findings, section:*, check:*, signal:*, context), result_fields and finding categories that post-review.sh renders and projects. Reviewer ids match the persona file names in personas/ or the stock skill's sub-agents/. Finding categories are values from the stock review-result category enum.",
  "dimensions": [
    {
      "id": "correctness",
      "label": "Correctness",
      "kind": "llm-subagent",
      "output": "findings",
      "categories": [
        "logic-error",
        "nil-deref",
        "off-by-one",
        "edge-case",
        "api-contract",
        "missing-test",
        "test-inadequate",
        "pattern-violation",
        "test-weakened",
        "test-removed",
        "mock-loosened",
        "assertion-weakened",
        "coverage-reduced",
        "test-poisoning",
        "split-payload",
        "stale-reference"
      ],
      "failure_severity": "high"
    },
    {
      "id": "security",
      "label": "Security",
      "kind": "llm-subagent",
      "output": "findings",
      "categories": [
        "auth-bypass",
        "rbac-violation",
        "data-exposure",
        "privilege-escalation",
        "injection-vuln",
        "sandbox-escape",
        "xss",
        "ssrf",
        "insecure-deserialization",
        "prompt-injection",
        "unicode-steganography",
        "bidi-override",
        "homoglyph-attack",
        "instruction-smuggling",
        "fail-open",
        "permission-expansion",
        "permission-reduction",
        "role-escalation",
        "workflow-permission",
        "secret-exposure"
      ],
      "failure_severity": "high"
    },
    {
      "id": "intent-coherence",
      "label": "Intent coherence",
      "kind": "llm-subagent",
      "output": "findings",
      "categories": [
        "scope-exceeded",
        "tier-mismatch",
        "unauthorized-change",
        "scope-creep",
        "missing-authorization",
        "misleading-label",
        "design-direction",
        "complexity-ratio",
        "misplaced-abstraction",
        "architectural-conflict",
        "design-smell",
        "over-engineering",
        "under-engineering",
        "scope-bundling"
      ],
      "failure_severity": "info"
    },
    {
      "id": "style-conventions",
      "label": "Style conventions",
      "kind": "llm-subagent",
      "output": "findings",
      "categories": [
        "naming-convention",
        "error-handling-idiom",
        "api-shape",
        "code-organization",
        "doc-style",
        "pattern-inconsistency"
      ],
      "failure_severity": "info"
    },
    {
      "id": "style-review",
      "label": "Style",
      "kind": "llm-skill",
      "output": "findings",
      "categories": [
        "pattern-violation",
        "pattern-inconsistency",
        "naming-convention",
        "code-organization"
      ],
      "failure_severity": "info"
    },
    {
      "id": "rbac-review",
      "label": "RBAC",
      "kind": "llm-skill",
      "output": "findings",
      "categories": [
        "missing-authorization",
        "fail-open",
        "rbac-violation",
        "permission-expansion",
        "data-exposure",
        "privilege-escalation"
      ],
      "failure_severity": "high"
    },
    {
      "id": "docs-currency",
      "label": "Docs currency",
      "kind": "llm-subagent",
      "output": "findings",
      "categories": [
        "stale-doc",
        "missing-doc",
        "incorrect-doc",
        "incomplete-doc"
      ],
      "failure_severity": "info"
    },
    {
      "id": "cross-repo-contracts",
      "label": "Cross-repo contracts",
      "kind": "llm-subagent",
      "output": "findings",
      "categories": [
        "breaking-api",
        "breaking-schema",
        "breaking-config",
        "breaking-cli",
        "missing-deprecation",
        "missing-version-bump",
        "backward-incompatible"
      ],
      "failure_severity": "info"
    },
    {
      "id": "jira-snapshot",
      "label": "Jira",
      "kind": "cli-adapter",
      "output": "context",
      "failure_severity": "info",
      "runner": "scripts/fetch-jira-context.sh",
      "producer_file": ".run/jira.json",
      "host": {
        "execution": "pre_review",
        "setup_runner": "",
        "credentials": {
          "url_env": "JIRA_URL",
          "username_env": "JIRA_USERNAME",
          "token_env": "JIRA_API_TOKEN"
        }
      },
      "notes": "Trusted host snapshot of the linked issue. It requests Jira through JIRA_URL and builds browse links from JIRA_BASE_URL. It contains context only and never enters challenger synthesis directly."
    },
    {
      "id": "coderabbit",
      "label": "CodeRabbit",
      "kind": "cli-adapter",
      "output": "findings",
      "categories": [
        "coderabbit"
      ],
      "failure_severity": "info",
      "runner": "scripts/fetch-coderabbit-context.sh",
      "producer_file": ".run/coderabbit.json",
      "host": {
        "execution": "pre_review",
        "setup_runner": "scripts/setup-coderabbit-cli.sh",
        "credentials": {
          "token_env": "CODERABBIT_API_KEY"
        }
      },
      "notes": "Host-side CodeRabbit CLI output, normalized without credentials. post-review.sh merges its findings into the sticky on the host. pre-review.sh also stages them as host-findings.json for the challenger, whose decisions the host applies. The transport is trusted; finding text is external review evidence."
    },
    {
      "id": "product-ask-review",
      "label": "Product ask",
      "kind": "llm-skill",
      "output": "section:product_ask",
      "result_fields": [
        "product_ask"
      ],
      "failure_severity": "info"
    },
    {
      "id": "test-impact-review",
      "label": "Test impact",
      "kind": "llm-skill",
      "output": "check:test-impact",
      "failure_severity": "info"
    },
    {
      "id": "pr-description-review",
      "label": "PR description",
      "kind": "llm-skill",
      "output": "check:pr-description",
      "failure_severity": "info"
    },
    {
      "id": "rating",
      "label": "Rating",
      "kind": "llm-subagent",
      "output": "signal:rating",
      "result_fields": [
        "risk",
        "confidence"
      ],
      "failure_severity": "info"
    }
  ]
}
