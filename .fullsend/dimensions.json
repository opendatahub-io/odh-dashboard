{
  "comment": "Review dimension registry. The orchestrator dispatches by output kind only: findings (then challenger), section:* in parallel with findings, then every check:* row, then every signal:* row. It must not special-case producer names. Context adapters are trusted host data and never enter challenger synthesis. Host post-review uses optional label for human-facing Check/Producer names; id remains the machine key. The Producers sticky table uses output (Type) and result_fields (signal/section Result cells).",
  "dimensions": [
    {
      "id": "investigator",
      "label": "Investigator",
      "kind": "llm-subagent",
      "output": "context",
      "stage": "pre-dispatch",
      "dispatch": "conditional",
      "when": "the change is not mechanical or value-only",
      "definition": "skills/pr-review/sub-agents/investigator.md",
      "meta_prompt": "meta-prompts/context-output.md",
      "failure_severity": "info",
      "notes": "Runs alone before the reviewer batch and returns a factual brief of the change and the code around it. Every findings, section, check and signal reviewer is told to read the brief as orientation. The challenger does not receive it, and it never enters synthesis."
    },
    {
      "id": "correctness",
      "label": "Correctness",
      "kind": "llm-subagent",
      "output": "findings",
      "dispatch": "always",
      "definition": "skills/pr-review/sub-agents/correctness.md",
      "meta_prompt": "meta-prompts/findings-output.md",
      "failure_severity": "high",
      "fallback": true,
      "budget_priority": 1,
      "re_review": "full",
      "categories": [
        "logic-error", "nil-deref", "off-by-one", "edge-case", "api-contract",
        "missing-test", "test-inadequate", "pattern-violation", "test-weakened",
        "test-removed", "mock-loosened", "assertion-weakened", "coverage-reduced",
        "test-poisoning", "split-payload", "stale-reference"
      ]
    },
    {
      "id": "security",
      "label": "Security",
      "kind": "llm-subagent",
      "output": "findings",
      "dispatch": "conditional",
      "when": "auth, permissions, secrets, data handling, string literals, config, or metadata are touched",
      "definition": "skills/pr-review/sub-agents/security.md",
      "meta_prompt": "meta-prompts/findings-output.md",
      "pre_pass": "skills/pr-review/sub-agents/security-triage.md",
      "failure_severity": "high",
      "budget_priority": 2,
      "re_review": "skip-unless-requalified",
      "categories": [
        "auth-bypass", "rbac-violation", "data-exposure", "privilege-escalation",
        "injection-vuln", "sandbox-escape", "xss", "ssrf", "insecure-deserialization",
        "prompt-injection", "unicode-steganography", "bidi-override", "homoglyph-attack",
        "instruction-smuggling", "fail-open", "permission-expansion",
        "permission-reduction", "role-escalation", "workflow-permission", "secret-exposure"
      ]
    },
    {
      "id": "intent-coherence",
      "label": "Intent coherence",
      "kind": "llm-subagent",
      "output": "findings",
      "dispatch": "conditional",
      "when": "linked issues exist or changes are non-trivial",
      "definition": "skills/pr-review/sub-agents/intent-coherence.md",
      "meta_prompt": "meta-prompts/findings-output.md",
      "failure_severity": "info",
      "budget_priority": 3,
      "re_review": "skip-unless-requalified",
      "categories": [
        "scope-exceeded", "tier-mismatch", "unauthorized-change", "scope-creep",
        "missing-authorization", "misleading-label", "design-direction",
        "complexity-ratio", "misplaced-abstraction", "architectural-conflict",
        "design-smell", "over-engineering", "under-engineering"
      ]
    },
    {
      "id": "style-conventions",
      "label": "Style conventions",
      "kind": "llm-subagent",
      "output": "findings",
      "dispatch": "always",
      "definition": "skills/pr-review/sub-agents/style-conventions.md",
      "meta_prompt": "meta-prompts/findings-output.md",
      "failure_severity": "info",
      "budget_priority": 4,
      "re_review": "trivial",
      "categories": [
        "naming-convention", "error-handling-idiom", "api-shape",
        "code-organization", "doc-style", "pattern-inconsistency"
      ]
    },
    {
      "id": "style-review",
      "label": "Style",
      "kind": "llm-skill",
      "output": "findings",
      "dispatch": "conditional",
      "when": "changed files include TSX, CSS, or SCSS outside upstream directories, especially custom styling, PatternFly components, wrappers, utility classes, or custom class names",
      "definition": "skills/pr-review/sub-agents/style-review/SKILL.md",
      "meta_prompt": "meta-prompts/findings-output.md",
      "failure_severity": "info",
      "budget_priority": 3,
      "re_review": "skip-unless-requalified",
      "categories": [
        "pf-priority-order", "pf-wrapper", "pf-token", "custom-class-naming",
        "patternfly-gap"
      ]
    },
    {
      "id": "rbac-review",
      "label": "RBAC",
      "kind": "llm-skill",
      "output": "findings",
      "dispatch": "conditional",
      "when": "changed code touches routes, pages, actions, data-fetching hooks, Kubernetes resources, permissions, SSAR, isAdmin, auth, namespaces, backend endpoints, or Go BFF proxy behavior",
      "definition": "skills/pr-review/sub-agents/rbac-review/SKILL.md",
      "meta_prompt": "meta-prompts/findings-output.md",
      "failure_severity": "high",
      "budget_priority": 2,
      "re_review": "skip-unless-requalified",
      "categories": [
        "missing-ssar", "rbac-fail-open", "assumed-admin-access",
        "namespace-scope", "limited-user-degradation", "rbac-data-exposure"
      ]
    },
    {
      "id": "docs-currency",
      "label": "Docs currency",
      "kind": "llm-subagent",
      "output": "findings",
      "dispatch": "conditional",
      "when": "the repository has documentation files",
      "definition": "skills/pr-review/sub-agents/docs-currency.md",
      "meta_prompt": "meta-prompts/findings-output.md",
      "inline_skill": "skills/docs-review/SKILL.md",
      "failure_severity": "info",
      "budget_priority": 4,
      "re_review": "skip-unless-requalified",
      "categories": ["stale-doc", "missing-doc", "incorrect-doc", "incomplete-doc"]
    },
    {
      "id": "cross-repo-contracts",
      "label": "Cross-repo contracts",
      "kind": "llm-subagent",
      "output": "findings",
      "dispatch": "conditional",
      "when": "public APIs, exported interfaces, schemas, or CLI args are modified",
      "definition": "skills/pr-review/sub-agents/cross-repo-contracts.md",
      "meta_prompt": "meta-prompts/findings-output.md",
      "failure_severity": "info",
      "budget_priority": 4,
      "re_review": "skip-unless-requalified",
      "categories": [
        "breaking-api", "breaking-schema", "breaking-config", "breaking-cli",
        "missing-deprecation", "missing-version-bump", "backward-incompatible"
      ]
    },
    {
      "id": "jira-snapshot",
      "label": "Jira",
      "kind": "cli-adapter",
      "output": "context",
      "dispatch": "always",
      "runner": "scripts/fetch-jira-context.sh",
      "producer_file": ".run/jira.json",
      "host": {
        "execution": "workflow",
        "artifact_name": "fullsend-jira-context-{pr_number}",
        "artifact_file": "jira.json",
        "checkout_pr": false,
        "setup_runner": "",
        "credentials": {
          "url_secret": "JIRA_URL",
          "username_secret": "JIRA_USERNAME",
          "token_secret": "JIRA_API_TOKEN"
        }
      },
      "failure_severity": "info",
      "notes": "Trusted host snapshot of the linked issue. It contains context only and never enters challenger synthesis directly."
    },
    {
      "id": "coderabbit",
      "label": "CodeRabbit",
      "kind": "cli-adapter",
      "output": "findings",
      "dispatch": "always",
      "runner": "scripts/fetch-coderabbit-context.sh",
      "producer_file": ".run/coderabbit.json",
      "host": {
        "execution": "workflow",
        "artifact_name": "fullsend-coderabbit-context-{pr_number}",
        "artifact_file": "coderabbit.json",
        "checkout_pr": false,
        "setup_runner": "scripts/setup-coderabbit-cli.sh",
        "credentials": {
          "url_secret": "FULLSEND_UNUSED",
          "username_secret": "FULLSEND_UNUSED",
          "token_secret": "CODERABBIT_API_KEY"
        }
      },
      "failure_severity": "info",
      "categories": ["coderabbit"],
      "notes": "Host-side CodeRabbit CLI output, normalized without credentials before challenger synthesis. The transport is trusted; finding text is external review evidence that must be verified against repository source."
    },
    {
      "id": "product-ask-review",
      "label": "Product ask",
      "kind": "llm-skill",
      "output": "section:product_ask",
      "result_fields": ["product_ask"],
      "dispatch": "always",
      "definition": "skills/pr-review/sub-agents/product-ask-review/SKILL.md",
      "meta_prompt": "meta-prompts/section-output.md",
      "context_file": "/sandbox/workspace/.fullsend/.run/jira.json",
      "include_findings": false,
      "failure_severity": "info",
      "re_review": "full",
      "notes": "Evaluates whether the PR's stated work fulfills the current Jira product ask. Section producer only — no findings, no challenger input. A disconnect floors confidence via host rating-policy."
    },
    {
      "id": "test-impact-review",
      "label": "Test impact",
      "kind": "llm-skill",
      "output": "check:test-impact",
      "dispatch": "always",
      "definition": "skills/pr-review/sub-agents/test-impact-review/SKILL.md",
      "meta_prompt": "meta-prompts/check-output.md",
      "failure_severity": "info",
      "budget_priority": 3,
      "re_review": "full",
      "notes": "Assurance-grade readiness check: Automation, Efficiency, Evidence depth. Overall status follows the applicable aspects. Check status may be fail → request-changes. Readiness check only; excluded from challenger input."
    },
    {
      "id": "pr-description-review",
      "label": "PR description",
      "kind": "llm-skill",
      "output": "check:pr-description",
      "dispatch": "always",
      "definition": "skills/pr-review/sub-agents/pr-description-review/SKILL.md",
      "meta_prompt": "meta-prompts/check-output.md",
      "failure_severity": "info",
      "budget_priority": 4,
      "re_review": "full",
      "notes": "Scores the PR body for substance independently of code findings."
    },
    {
      "id": "rating",
      "label": "Rating",
      "kind": "llm-subagent",
      "output": "signal:rating",
      "result_fields": ["risk", "confidence"],
      "dispatch": "always",
      "definition": "skills/pr-review/sub-agents/rating.md",
      "meta_prompt": "meta-prompts/signal-output.md",
      "failure_severity": "info",
      "re_review": "full",
      "notes": "Signal producer. Runs only after every selected check:* row. Projects result_fields onto the review result. Not a findings producer and not challenger input."
    }
  ]
}
