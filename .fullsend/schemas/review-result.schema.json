{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-result.schema.json",
  "title": "Review Agent Result",
  "description": "Agent fills findings, semantic sections, readiness checks, signal fields (risk, confidence), change_summary, optional todo, inspected, and producers. The host post-script sets action and body.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pr_number", "repo", "head_sha"],
  "properties": {
    "action": { "type": "string", "enum": ["approve", "request-changes", "comment", "reject", "failure"] },
    "pr_number": { "type": "integer", "minimum": 1 },
    "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$|^[0-9a-fA-F]{64}$" },
    "body": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "const": "3" },
    "change_summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "reason": { "type": "string", "enum": ["tool-failure", "missing-context", "ambiguous-findings", "token-limit"] },
    "risk": { "$ref": "#/$defs/rated" },
    "confidence": { "$ref": "#/$defs/confidence_rated" },
    "product_ask": { "$ref": "#/$defs/product_ask" },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/readiness_check" }
    },
    "todo": {
      "type": "array",
      "description": "Review-derived action list. Plain strings rendered as sticky ## TODO bullets. Empty or omitted when nothing remains.",
      "items": { "type": "string", "minLength": 1 }
    },
    "producers": { "$ref": "#/$defs/producers" },
    "inspected": { "$ref": "#/$defs/inspected" },
    "label_actions": { "$ref": "#/$defs/label_actions" }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "failure" } }, "required": ["action"] },
      "then": { "required": ["reason"] },
      "else": { "required": ["risk", "confidence", "change_summary", "producers"] }
    },
    {
      "if": { "required": ["reason"] },
      "then": {
        "properties": { "action": { "const": "failure" } },
        "required": ["action"]
      }
    }
  ],
  "$defs": {
    "rated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "why"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Blast radius if this head ships wrong: low is narrow/internal; medium is feature-local or sensitive-adjacent; high is wide (multi-package or shared-contract) blast radius; critical is trust-boundary/data-loss impact or a monorepo-foundation change. Not finding severity."
        },
        "why": { "type": "string", "minLength": 1 }
      }
    },
    "confidence_rated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "why"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "How sure this change fulfills its stated intent (min of intent and verified evidence; completeness is a ceiling only): high means intent matches and evidence is proportionate; medium is thin/partial or capped; low cannot support approve."
        },
        "why": { "type": "string", "minLength": 1 }
      }
    },
    "inspected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "could_not_verify": { "type": "array", "items": { "type": "string" } }
      }
    },
    "finding": {
      "type": "object",
      "required": ["severity", "category", "file", "description"],
      "properties": {
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
        "category": { "type": "string", "minLength": 1 },
        "dimension": { "type": "string", "minLength": 1, "description": "Registry id of the producer this finding came from. The orchestrator stamps it at collect; it is what lets a reader tell which reviewer found what." },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "actionable": { "type": "boolean" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "severity": { "enum": ["critical", "high", "medium"] } }, "required": ["severity"] },
          "then": { "required": ["why"] }
        },
        {
          "if": { "properties": { "severity": { "enum": ["critical", "high"] } }, "required": ["severity"] },
          "then": { "required": ["remediation"] }
        }
      ]
    },
    "removed_finding": {
      "type": "object",
      "description": "Audit-only copy of a finding the challenger removed, merged, or justified away. Items with challenger_action justified are rendered under Findings ### Justified; all others appear in the Challenger removed-audit UI.",
      "required": ["severity", "category", "file", "description", "removal_reason"],
      "properties": {
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
        "category": { "type": "string", "minLength": 1 },
        "dimension": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "actionable": { "type": "boolean" },
        "removal_reason": { "type": "string", "minLength": 1 },
        "challenger_action": { "type": "string", "enum": ["removed", "merged", "justified"] }
      },
      "additionalProperties": false
    },
    "adapter_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["ok", "none", "skipped", "error"] },
        "reason": { "type": "string" }
      }
    },
    "challenger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "ran", "skipped", "failed"] },
        "reason": { "type": "string" },
        "input": { "type": "integer", "minimum": 0 },
        "kept": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "merged": { "type": "integer", "minimum": 0 },
        "downgraded": { "type": "integer", "minimum": 0 },
        "removed_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/removed_finding" }
        }
      }
    },
    "producers": {
      "type": "object",
      "description": "Self-contained dispatch ledger mirror plus as-raised findings and expanded challenger audit. Host sticky Ran/Result/audit read this object only.",
      "additionalProperties": false,
      "required": ["dispatched", "adapters", "skipped", "raised", "challenger"],
      "properties": {
        "dispatched": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "adapters": {
          "type": "array",
          "items": { "$ref": "#/$defs/adapter_status" }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "returned": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "raised": {
          "type": "object",
          "description": "As-raised findings per findings-producer id (pre-challenger history). Drives the Producers Result column.",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/finding" }
          }
        },
        "challenger": { "$ref": "#/$defs/challenger" }
      }
    },
    "product_ask": {
      "type": "object",
      "description": "PR description vs linked Jira description. Not code-vs-acceptance-criteria and not sent through the challenger.",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["none", "aligned", "mismatch-justified", "mismatch-unjustified"] },
        "aligned": { "type": "array", "items": { "type": "string" } },
        "mismatched": { "type": "array", "items": { "type": "string" } },
        "justified_in_description": { "type": "boolean" },
        "needs_human": { "type": "boolean" }
      }
    },
    "readiness_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["pass", "fail", "warning", "not-applicable", "could-not-verify"] },
        "summary": { "type": "string", "minLength": 1 },
        "details": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "label_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "actions"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "label"],
            "properties": {
              "action": { "type": "string", "enum": ["add", "remove"] },
              "label": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9._/: +-]+$" }
            }
          }
        }
      }
    }
  }
}
